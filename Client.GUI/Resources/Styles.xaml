<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Базовый стиль для всех кнопок -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="LightBlue"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для кнопки меню-->
    <Style x:Key="ButtonMenuStyle" TargetType="Button"
        BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="DarkSeaGreen"/>
        <Setter Property="Width" Value="250"/>
        <Setter Property="Height" Value="50"/>
    </Style>

    <!-- Стиль для доп кнопки меню -->
    <Style x:Key="ButtonSmallMenuStyle" TargetType="Button" 
        BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="DarkKhaki"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="50"/>
    </Style>



    <!-- Базовый стиль для всех Label -->
    <Style x:Key="BaseLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль для заголовка -->
    <Style x:Key="LabelMenuStyle" TargetType="Label"
        BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Стиль для другого Label -->
    <Style x:Key="Heading" TargetType="Label" 
        BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Стиль для выравнивания по центру -->
    <Style x:Key="CenteredAlignmentStyle" TargetType="FrameworkElement">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Общий базовый стиль для TextBox и PasswordBox -->
    <Style x:Key="BaseInputStyle" TargetType="Control">
        <Setter Property="Margin" Value="0 5 0 5"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush" Value="#ccc"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Стиль для TextBox -->
    <Style x:Key="TextBoxMenu" TargetType="TextBox" BasedOn="{StaticResource BaseInputStyle}" />


    <!-- Стиль для PasswordBox -->
    <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource BaseInputStyle}" />

    <!-- Общий стиль для TextBox -->
    <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BaseInputStyle}"/>


    <!-- Общий стиль для Label -->
    <Style x:Key="InputLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0 5 0 5"/>
    </Style>

  
<!--DataGrid-->

    <!-- Стили строк -->
    <Style TargetType="DataGridRow" x:Key="DataGridRowStyle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="DarkSeaGreen"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стили ячеек -->
    <Style TargetType="DataGridCell" x:Key="DataGridCellStyle">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
    </Style>

    <!-- Стили заголовков колонок -->
    <Style TargetType="DataGridColumnHeader" x:Key="DataGridColumnHeaderStyle">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="DarkKhaki"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>


</ResourceDictionary>