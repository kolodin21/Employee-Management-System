<UserControl x:Class="Client.GUI.View.EmployeeAllPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModel="clr-namespace:Client.GUI.ViewModel">

    <UserControl.DataContext>
        <viewModel:EmployeeAllPageViewModel/>
    </UserControl.DataContext>



    <Grid Background="AntiqueWhite">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <Label Content="Действия"
               Style="{StaticResource LabelMenuStyle}"/>

            <Button Content="Редактирование"
                Style="{StaticResource ButtonSmallMenuStyle}"/>

            <Button Content="Удаление"
                Command="{Binding DeleteEmployeeCommand}"
                Style="{StaticResource ButtonSmallMenuStyle}"/>

        </StackPanel>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label 
                Grid.Row="0"
                Content="Все сотрудники компании "
                Style="{StaticResource LabelMenuStyle}"/>

            <!--Все сотрудники-->
            <DataGrid Grid.Row="1" 
                  Margin="0,0,0,5"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  IsReadOnly="True"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="35"/>

                    <DataGridTemplateColumn Header="Имя сотрудника" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="Name"/>
                                            <Binding Path="Surname"/>
                                            <Binding Path="Patronymic"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Департамент" Binding="{Binding Department}" Width="200"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="200"/>
                    <DataGridTextColumn Header="Дата устройства" Binding="{Binding HireDate,StringFormat=\{0:dd.MM.yyyy\}}" Width="auto" />

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>

</UserControl>
