<UserControl x:Class="Client.GUI.View.AdminPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Client.GUI.ViewModel"
             Height="600"
             Width="1300">

    <UserControl.DataContext>
        <vm:AdminPageViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Основной Grid -->
    <Grid Background="AntiqueWhite">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <!--Верхнее меню и название-->
        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Название-->
            <Label Grid.Row="0" 
                   Content="Управление сотрудниками"
                   Style="{StaticResource Heading}"/>

            <!--Меню для дополнительных кнопок управления-->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="51*"/>
                    <ColumnDefinition Width="14*"/>
                </Grid.ColumnDefinitions>

                <Label
                       Content="Все сотрудники компании "
                       Style="{StaticResource LabelMenuStyle}"/>
            </Grid>
        </Grid>


        <!--Основное меню и поле для смены страниц-->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Основное меню-->
            <StackPanel Grid.Column="1">

                <Label Content="Меню"
                       Style="{StaticResource LabelMenuStyle}"/>

                <Button Content="Все сотрудники"
                        Command="{Binding LoadEmployeeCommand}"
                        Style="{StaticResource ButtonMenuStyle}"/>

                <Button Content="Добавление сотрудника"
                        Command="{Binding OpenAddEmployeeCommand}"
                        Style="{StaticResource ButtonMenuStyle}"/>

                <Button Content="Учет отпусков и больничных"
                        Command="{Binding AccountingCommand }"
                        Style="{StaticResource ButtonMenuStyle}"/>

                <Button Content="Формирование отчетов"
                        Command="{Binding GeneratingReportsCommand}"
                        Style="{StaticResource ButtonMenuStyle}"/>

                <Button Content="Изменение отделов и должностей"
                        Command="{Binding ChangingCommand}"
                        Style="{StaticResource ButtonMenuStyle}"/>

                <Button Content="Выход"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource ButtonMenuStyle}"/>

            </StackPanel>

            <!--Поле для смены представлении-->
            <Grid Grid.Column="0" 
                  Visibility="{Binding IsLoadEmployee,
                                Converter={StaticResource BoolToVis}}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Все сотрудники-->
                <DataGrid Grid.Column="1"
                          Margin="0,0,0,5"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}"
                          IsReadOnly="True"
                          RowStyle="{StaticResource DataGridRowStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="35"/>

                        <DataGridTemplateColumn Header="Имя сотрудника" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                                <Binding Path="Name"/>
                                                <Binding Path="Surname"/>
                                                <Binding Path="Patronymic"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Департамент" Binding="{Binding Department}" Width="200"/>
                        <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="200"/>
                        <DataGridTextColumn Header="Дата устройства" Binding="{Binding HireDate,StringFormat=\{0:dd.MM.yyyy\}}" Width="auto" />

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="0">

                    <Label Content="Действия"
                           Style="{StaticResource LabelMenuStyle}"/>

                    <Button Content="Редактирование"
                            Style="{StaticResource ButtonSmallMenuStyle}"/>

                    <Button Content="Удаление"
                            Command="{Binding DeleteEmployeeCommand}"
                            Style="{StaticResource ButtonSmallMenuStyle}"/>

                </StackPanel>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
