<UserControl x:Class="Client.GUI.View.AdminPageMenu.EmployeeAllPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:component="clr-namespace:Client.GUI.Components"
             xmlns:adminPageMenu="clr-namespace:Client.GUI.ViewModel.AdminPageMenu">


    <UserControl.DataContext>
        <adminPageMenu:EmployeeAllPageViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>


    <Grid Background="AntiqueWhite">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <Label Content="Действия"
               Style="{StaticResource LabelMenuStyle}"/>

            <Button Content="Редактирование"
                    Command="{Binding EditEmployeeCommand}"
                    Style="{StaticResource ButtonSmallMenuStyle}"
                    Visibility="{Binding IsActiveButtonEdit,
                                 Converter={StaticResource BoolToVis}}"/>

            <Button Content="Удаление"
                Command="{Binding DeleteEmployeeCommand}"
                Style="{StaticResource ButtonSmallMenuStyle}"/>

            <Button Content="Назад"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource ButtonSmallMenuStyle}"
                    Visibility="{Binding IsOpenWindowEdit,
                        Converter={StaticResource BoolToVis}}"/>

        </StackPanel>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label 
                Grid.Row="0"
                Content="Все сотрудники компании "
                Style="{StaticResource Heading}"/>

            <!--Все сотрудники-->
            <DataGrid 
                  Visibility="{Binding IsOpenWindowAllEmployee,Converter={StaticResource BoolToVis }}"
                  Grid.Row="1" 
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  IsReadOnly="True"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="35"/>

                    <DataGridTemplateColumn Header="Имя сотрудника" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="Name"/>
                                            <Binding Path="Surname"/>
                                            <Binding Path="Patronymic"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Департамент" Binding="{Binding Department}" Width="200"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="200"/>
                    <DataGridTextColumn Header="Дата устройства" Binding="{Binding HireDate,StringFormat=\{0:dd.MM.yyyy\}}" Width="auto" />

                </DataGrid.Columns>
            </DataGrid>

            <Grid 
                Visibility="{Binding IsOpenWindowEdit,Converter={StaticResource BoolToVis}}"
                Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="0,20,0,0" >
                   
                <Label
                    Content="Редактирование сотрудника"
                       Style="{StaticResource HeadingSmall}"/>

                <component:InputControl
                    Label="Имя"
                    InputText="{Binding Name}"/>

                <component:InputControl
                    Label="Фамилия"
                    InputText="{Binding Surname}"/>

                <component:InputControl
                    Label="Отчество"
                    InputText="{Binding Patronymic}"/>

                <component:ComboBoxControl
                    Label="Департамент"
                    ItemsSource="{Binding DepartmentsList}"
                    SelectedItem="{Binding SelectedDepartment,Mode=TwoWay}"/>

                <component:ComboBoxControl
                    Label="Должность"
                    ItemsSource="{Binding PositionList}"
                    SelectedItem="{Binding SelectedPosition,Mode=TwoWay}"/>

                <component:DataPickerControl
                    Label="Дата устройства"
                    SelectedDate="{Binding HireDate}"/>


                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ButtonMenuStyle}"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>

</UserControl>
