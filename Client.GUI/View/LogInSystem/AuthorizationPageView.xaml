<UserControl x:Class="Client.GUI.View.LogInSystem.AuthorizationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Client.GUI.Components"
             xmlns:logInSystem="clr-namespace:Client.GUI.ViewModel.LogInSystem"
             Height="350" 
             Width="400">

    <UserControl.DataContext>
        <logInSystem:AuthorizationPageViewModel/>
    </UserControl.DataContext>

    <Grid Background="AntiqueWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

    <StackPanel Margin="20">
        <Label Content="Авторизация"
               Style="{StaticResource LabelMenuStyle}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="20,20,20,20">
        <components:InputControl
            Label="Логин"
            InputText="{Binding Login}"/>

        <components:InputPasswordControl
            Label="Пароль"
            InputPassword="{Binding Password,Mode=TwoWay}"/>
    </StackPanel>

    <StackPanel Grid.Row="2">

        <Button Content="Войти" 
                Command="{Binding EnterCommand}"
                Style="{StaticResource ButtonMenuStyle}"/>

        <Button Content="Назад"
                Command="{Binding BackCommand}"
                Style="{StaticResource ButtonMenuStyle}"/>

    </StackPanel>
    </Grid>
</UserControl>
